# Copy to .env and fill in. NEVER commit .env (it is git-ignored).
# Only the providers you actually use need keys.

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
XAI_API_KEY=

# Optional overrides
# OPENAI_BASE_URL=https://api.openai.com/v1
# XAI_BASE_URL=https://api.x.ai/v1
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# GOOGLE_BASE_URL=https://generativelanguage.googleapis.com

# Communication layer settings
AGENTCOMM_DEFAULT_TIMEOUT=30
AGENTCOMM_LOG_LEVEL=INFO
# AGENTCOMM_HISTORY_PATH=./data/history.jsonl
